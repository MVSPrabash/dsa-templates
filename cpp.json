    "Modular Integer Template":{
        "prefix": "modint",
        "body": [
            "template<class T>",
            "constexpr T power(T a, u64 b, T res = 1) {",
            "\twhile (b > 0) {",
            "\t\tif (b & 1) res *= a;",
            "\t\ta *= a;",
            "\t\tb >>= 1;",
            "\t}",
            "\treturn res;",
            "}",
            "",
            "template<u32 P>",
            "class ModInt {",
            "public:",
            "\tconstexpr ModInt() : x{0} {}",
            "\ttemplate<std::unsigned_integral T>",
            "\tconstexpr ModInt(T v) : x(v % mod()) {}",
            "\ttemplate<std::signed_integral T>",
            "\tconstexpr ModInt(T v) {",
            "\t\ti64 xx = v % static_cast<i64>(mod());",
            "\t\tif (xx < 0) xx += mod();",
            "\t\tx = xx;",
            "\t}",
            "",
            "\tstatic constexpr u32 mod() { return P; }",
            "",
            "\tconstexpr u32 val() const { return x; }",
            "",
            "\tconstexpr ModInt inv() const {",
            "\t\treturn power(*this, mod() - 2);",
            "\t}",
            "",
            "\tconstexpr ModInt& operator+=(const ModInt& rhs) {",
            "\t\tx += rhs.val();",
            "\t\tif (x >= mod()) x -= mod();",
            "\t\treturn *this;",
            "\t}",
            "",
            "\tconstexpr ModInt& operator-=(const ModInt& rhs) {",
            "\t\tint xx = x - rhs.val();",
            "\t\tif (xx < 0) xx += mod();",
            "\t\tx = xx;",
            "\t\treturn *this;",
            "\t}",
            "",
            "\tconstexpr ModInt& operator*=(const ModInt& rhs) {",
            "\t\tx = u64(x) * rhs.x % mod();",
            "\t\treturn *this;",
            "\t}",
            "",
            "\tconstexpr ModInt& operator/=(const ModInt& rhs) {",
            "\t\treturn *this *= rhs.inv();",
            "\t}",
            "",
            "\tfriend constexpr bool operator==(const ModInt& lhs, const ModInt& rhs) {",
            "\t\treturn lhs.val() == rhs.val();",
            "\t}",
            "",
            "\tconstexpr ModInt& operator++() {",
            "\t\treturn *this += 1;",
            "\t}",
            "",
            "\tconstexpr ModInt& operator--() {",
            "\t\treturn *this -= 1;",
            "\t}",
            "",
            "\tfriend constexpr ModInt operator+(ModInt lhs, const ModInt& rhs) {",
            "\t\treturn lhs += rhs;",
            "\t}",
            "",
            "\tfriend constexpr ModInt operator-(ModInt lhs, const ModInt& rhs) {",
            "\t\treturn lhs -= rhs;",
            "\t}",
            "",
            "\tfriend constexpr ModInt operator*(ModInt lhs, const ModInt& rhs) {",
            "\t\treturn lhs *= rhs;",
            "\t}",
            "",
            "\tfriend constexpr ModInt operator/(ModInt lhs, const ModInt& rhs) {",
            "\t\treturn lhs /= rhs;",
            "\t}",
            "",
            "\tconstexpr ModInt operator-() const {",
            "\t\treturn ModInt((x == 0 ? 0 : mod() - x));",
            "\t}",
            "",
            "\tfriend std::ostream& operator<<(std::ostream& os, const ModInt& z) {",
            "\t\tos << z.val();",
            "\t\treturn os;",
            "\t}",
            "",
            "\tfriend std::istream& operator>>(std::istream& is, ModInt& z) {",
            "\t\ti64 x;",
            "\t\tis >> x;",
            "\t\tz = x;",
            "\t\treturn is;",
            "\t}",
            "private:",
            "\tu32 x;",
            "};",
            "",
            "using Z = ModInt<$0>;",
        ]
    },
    "Range Frequency Query data structure": {
        "prefix": "rangefreqquery",
        "body": [
            "struct RangeFreqQuery {",
            "\tstd::map<int, std::vector<int>> mp;",
            "",
            "\texplicit",
            "\tRangeFreqQuery(const std::vector<int>& arr) {",
            "\t\tfor (int i = 0; i < static_cast<int>(arr.size()); i++) {",
            "\t\t\tmp[arr[i]].push_back(i);",
            "\t\t}",
            "\t}",
            "",
            "\tint query(int left, int right, int value) const {",
            "\t\tif (left > right) return 0;",
            "",
            "\t\tauto it = mp.find(value);",
            "",
            "\t\tif (it == mp.end()) return 0;",
            "",
            "\t\tconst auto& indices = it->second;",
            "",
            "\t\treturn static_cast<int>(",
            "\t\t\trgs::upper_bound(indices, right) -",
            "\t\t\trgs::lower_bound(indices, left)",
            "\t\t);",
            "\t}",
            "",
            "};"
        ]
    },
